SECRET_KEY=change-this-before-deployment
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173
DB_NAME=edulead
DB_USER=root
DB_PASSWORD=your_mysql_password
